# Copy to .env (repo root for docker compose, or backend/.env for local dev) and fill in.
# Never commit the real .env.

# --- LLM: set ONE of these (none = scripted offline mock) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# --- Web search + image search ---
SERPAPI_API_KEY=

# --- Database: Supabase pooled Postgres URL (port 6543). Empty = SQLite in the container volume ---
DATABASE_URL=

# --- Secrets vault: any long random string; keep it stable or stored secrets become unreadable ---
# python -c "import secrets;print(secrets.token_urlsafe(48))"
VAULT_KEY=

# --- Public URLs (what the user's browser sees) ---
# BACKEND_URL is also the base of the Google OAuth redirect: <BACKEND_URL>/api/auth/google/callback
BACKEND_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000

# --- Optional: Sign in with Google (real Gmail) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Optional: cron endpoint protection (/api/watches/tick_all) ---
CRON_SECRET=

# --- Optional: natural voices (otherwise the browser speaks) ---
ELEVENLABS_API_KEY=

# --- Tuning ---
MAX_PARALLEL_AGENTS=5
MAX_DEPTH=3
BRANCH_TOKEN_BUDGET=40000
CONFIDENCE_THRESHOLD=0.6
SANDBOX_TIMEOUT_SEC=20
WATCH_INTERVAL_SEC=15
